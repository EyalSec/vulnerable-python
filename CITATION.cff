    family-names: Gabay
    affiliation: EyalSec
    email: eyal@eyalsec.com
license: MIT
repository-code: "https://github.com/EyalSec/vulnerable-python"
url: "https://eyalsec.com/vulnerabilities"
keywords:
  - application security
  - deliberately vulnerable
  - security training
  - sql injection
  - command injection
  - path traversal
  - ssrf
  - python
  - flask
